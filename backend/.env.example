# DineFlow Environment
APP_NAME=DineFlow
APP_ENV=development
DEBUG=true
API_PREFIX=/api/v1
SECRET_KEY=change-me-to-a-long-random-secret-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_DAYS=30

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=Baton@1230
DB_NAME=pos_platform
DB_POOL_SIZE=50
DB_MAX_OVERFLOW=100
DB_POOL_RECYCLE=1800

# Server
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Super Admin bootstrap (created on first migration/seed)
SUPER_ADMIN_EMAIL=superadmin@pos.local
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_PASSWORD=superadmin
SUPER_ADMIN_NAME=Super Admin
